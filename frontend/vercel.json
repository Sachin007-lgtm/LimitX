{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-render-app.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://your-render-app.onrender.com/auth/$1"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "https://your-render-app.onrender.com/webhooks/$1"
    },
    {
      "source": "/health",
      "destination": "https://your-render-app.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
