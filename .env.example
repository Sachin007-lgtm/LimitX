# Redis connection
REDIS_URL=redis://localhost:6379

# Gateway config
PORT=3000
NODE_ENV=development

# Fail strategy when Redis is unavailable: "open" (allow all) | "closed" (block all)
REDIS_FAIL_STRATEGY=open

# Default rate limit (requests per window)
DEFAULT_LIMIT=100
DEFAULT_WINDOW_MS=60000

# Optional upstream to proxy to (leave empty to return decision-only responses)
UPSTREAM_URL=
